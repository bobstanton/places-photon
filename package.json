{
  "name": "places-photon",
  "version": "0.0.1",
  "description": "Search provider for Places using Photon, with POI search over OpenStreetMap data.",
  "main": "main.js",
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "watch": "node esbuild.config.mjs watch"
  },
  "keywords": [],
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "obsidian": "^1.13.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "places-shared": "git+https://github.com/bobstanton/places-shared.git#0.0.1"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
